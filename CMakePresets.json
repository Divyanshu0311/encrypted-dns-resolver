{
  "version": 3,
  "configurePresets": [
    {
      "name": "local",
      "displayName": "Local g++-15 debug build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/local",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-15",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "local",
      "displayName": "Local g++-15 optimised build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "local",
      "displayName": "AddressSanitizer + UBSan",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "inherits": "local",
      "displayName": "ThreadSanitizer",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "local", "configurePreset": "local", "jobs": 8 },
    { "name": "release", "configurePreset": "release", "jobs": 8 },
    { "name": "asan", "configurePreset": "asan", "jobs": 8 },
    { "name": "tsan", "configurePreset": "tsan", "jobs": 8 }
  ],
  "testPresets": [
    { "name": "local", "configurePreset": "local", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": { "outputOnFailure": true },
      "environment": { "TSAN_OPTIONS": "halt_on_error=1" }
    }
  ]
}
